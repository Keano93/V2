# Local SQLite database (created automatically by `npm run dev`).
DATABASE_URL="file:./dev.db"

# Anthropic API key for AI detection. Never commit a real key.
# Leave blank to use only cached results and the keyword baseline.
ANTHROPIC_API_KEY=""

# Model and effort used for event detection. Changing either invalidates the result cache.
ANTHROPIC_MODEL="claude-opus-5-5"
# low | medium | high
ANTHROPIC_EFFORT="medium"
